# Copy to .env and adjust. Never commit .env.

# --- Ollama ---
SCANNER_OLLAMA_HOST=http://localhost:11434
SCANNER_TRIAGE_MODEL=gemma3:12b
SCANNER_EMBED_MODEL=nomic-embed-text
# Ollama model residency: -1 keeps Gemma loaded; use 5m to release idle VRAM.
SCANNER_LLM_KEEP_ALIVE=45m

# --- SEC EDGAR requires a descriptive UA with contact info, or it 403s ---
SCANNER_SEC_USER_AGENT=stock-scanner/0.1 (your.email@example.com)

# --- Alpaca paper trading (scripts/trade.py). Paper keys only. ---
# Get them from the Alpaca dashboard; the paper and live keys are different,
# and this project only ever talks to the paper endpoint.
SCANNER_ALPACA_KEY_ID=
SCANNER_ALPACA_SECRET_KEY=

# --- Optional paid/keyed sources (leave blank to disable) ---
SCANNER_FINNHUB_API_KEY=
SCANNER_TIINGO_API_KEY=
