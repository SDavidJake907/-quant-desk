{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Global market board",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/global_board.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Trend screen (S&P 500)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/find_candidates.py",
      "args": ["--show", "15"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Backtest (all screens)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/backtest.py",
      "args": ["--screen", "all", "--range", "5y"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "News scan (Gemma 3)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_scan.py",
      "args": ["NVDA", "AAPL"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
